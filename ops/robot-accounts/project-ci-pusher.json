{
  "name": "ci-pusher",
  "description": "GitHub Actions CI/CD robot account",
  "duration": 30,
  "level": "project",
  "permissions": [
    {
      "kind": "project",
      "namespace": "backend",
      "access": [
        {"resource": "repository", "action": "push"},
        {"resource": "repository", "action": "pull"},
        {"resource": "tag", "action": "create"},
        {"resource": "artifact", "action": "delete"}
      ]
    }
  ]
}
